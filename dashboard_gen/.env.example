# Environment variables for DashboardGen
# Copy this file to .env and fill in your secrets
OPENAI_API_KEY=

# Host port binding for PostgreSQL (host:container), default is 5434
DB_HOST_PORT=5434

# Host port binding for the web application (host:container), default is 4000
APP_HOST_PORT=4000

# Internal port for the web application inside the container, default is 4000
PORT=4000
