# The directory Mix will write compiled artifacts to.
/_build/
.DS_Store
../.DS_Store

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
dashboard_gen-*.tar

# Temporary files, for example, from tests.
/tmp/

# Phoenix compiled static assets and manifest
/priv/static/assets/
/priv/static/cache_manifest.json

# ElixirLS / editor settings
/.elixir_ls/
/.vscode/
/.idea/

# Node.js dependencies for assets
/assets/node_modules/
/assets/.parcel-cache/

# Python virtual env and caches
/venv/
__pycache__/
*.py[cod]

# Environment files (keep examples tracked)
.env
.env.*
!.env.example
!.env.*.example

# Logs and pids
*.log
*.pid
/server.log
/server_test.log

# Tooling/AI artifacts
/.claude/

# Project-specific generated data
/scrape_output.json
.env.prod
